{
  "name": "@iaziz786/pi-merge-gateway-login",
  "version": "0.4.0",
  "description": "Pi extension that adds the Merge Dev gateway (docs.merge.dev/merge-gateway) as a model provider via its OpenAI Responses API, hosting GLM 5.3 Flash and DeepSeek V4 Flash / V4.1 Flash routes.",
  "keywords": ["pi-package", "extension", "merge-gateway", "merge-dev", "glm", "zai", "deepseek", "deepseek-v4"],
  "type": "module",
  "license": "MIT",
  "author": "Mohammad Aziz",
  "homepage": "https://github.com/iAziz786/pi-merge-gateway-login#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/iAziz786/pi-merge-gateway-login.git"
  },
  "main": "./dist/index.js",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "build": "bun build ./index.ts --outdir ./dist --target node --format esm --external '@earendil-works/*'",
    "prepublishOnly": "bun run build && bun test",
    "test": "bun test"
  },
  "pi": {
    "extensions": ["./dist/index.js"]
  }
}
